{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate from CSV",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CalendarStyleCreator/bin/Release/net10.0/VehicleVision.PleasanterTools.CalendarStyleCreator.dll",
      "args": ["generate", "/csv", "${workspaceFolder}/examples/holidays.csv", "/output", "${workspaceFolder}/temp/out"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
